{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:palimpsest:schema:12.table_row",
 "title": "Table row records of chapter 12",
 "description": "Generated by tools/catalog/extract_content.py from a chapter table row whose first cell is a backticked ID. Fields keep the table text; field semantics are not validated.",
 "x-owner": "12",
 "$ref": "urn:palimpsest:schema:common#/$defs/record_base",
 "unevaluatedProperties": false,
 "required": [
  "kind",
  "owner",
  "section",
  "fields"
 ],
 "properties": {
  "kind": {
   "type": "string",
   "minLength": 1
  },
  "owner": {
   "type": "string",
   "pattern": "^(0[0-9]|1[0-8]|21)$"
  },
  "section": {
   "type": "string"
  },
  "fields": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "also_in": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}