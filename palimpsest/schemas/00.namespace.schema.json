{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palimpsest:schema:00.namespace",
  "title": "Namespace ownership and retired IDs",
  "description": "Doc 19 §1.4. Generated by tools/gen_namespaces.py from canon §19 (one prefix record per namespace prefix) and canon §17.7 (one retired record per retired ID or prefix). Never edited by hand.",
  "x-owner": "00",
  "$ref": "urn:palimpsest:schema:common#/$defs/record_base",
  "required": ["kind", "source"],
  "properties": {
    "id": { "pattern": "^meta\\.(ns|retired)\\." },
    "kind": { "enum": ["prefix", "retired"] },
    "source": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.([a-z0-9_]+\\.){0,4}$" },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:palimpsest:schema:common#/$defs/doc_dir" }
    },
    "rule_owners": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:palimpsest:schema:common#/$defs/doc_dir" }
    },
    "owner_text": { "type": "string", "minLength": 1 },
    "text_keys": { "type": "boolean" },
    "row": { "type": "integer", "minimum": 1, "maximum": 255 },
    "retired": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,5}\\.?$" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "prefix" } } },
      "then": {
        "required": ["prefix", "owners", "rule_owners", "owner_text", "text_keys", "row"],
        "properties": { "id": { "pattern": "^meta\\.ns\\." } },
        "not": { "required": ["retired"] }
      },
      "else": {
        "required": ["retired"],
        "properties": { "id": { "pattern": "^meta\\.retired\\." } },
        "not": { "anyOf": [{ "required": ["prefix"] }, { "required": ["owners"] }, { "required": ["rule_owners"] }, { "required": ["owner_text"] }, { "required": ["text_keys"] }, { "required": ["row"] }] }
      }
    }
  ],
  "unevaluatedProperties": false
}
