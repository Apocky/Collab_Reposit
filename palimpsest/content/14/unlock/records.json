   "id": "unlock.set.starter",
   "kind": "unlock",
   "owner": "14",
   "section": "14 2.3 Content sets",
   "fields": {
    "contents": "content every account owns at creation: Callings Vanguard, Duelist, Gunslinger, Spellwright; Origins Mythic Fantasy, Gothic Horror, Cyberpunk, Weird West; the 13 standard kits; every item, room and event not gated by a `unlock.loot.*`, `unlock.room.*`, `unlock.event.*`, `unlock.glyph.*` or `unlock.hireling.*` ID"
   },
   "also_in": []
  },
